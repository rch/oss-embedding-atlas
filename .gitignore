.DS_Store
__pycache__/
node_modules/
.ipynb_checkpoints/
tmp/
build/
thirdparty/
dist/
distlib/

# Pre-built artifacts for embedding-atlas package (CAI deployment).
# The full workspace build chain requires uv, Emscripten, Rust/wasm-bindgen
# which aren't available on bare CAI runtimes. These committed artifacts
# allow consumers to use the package without rebuilding from source.
!packages/embedding-atlas/dist/
!packages/embedding-atlas/svelte/
target/
*.tsbuildinfo
.svelte-kit/
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml
